# Build stage - используем Ubuntu вместо Alpine для совместимости
FROM golang:1.24-bookworm AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy go mod files first for better caching
COPY server/go.mod server/go.sum ./
RUN go mod download

# Copy source code
COPY server/ .

# Build only the server binary with minimal tags
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-s -w -X main.BuildNumber=docker" \
    -o mattermost-server \
    ./cmd/mattermost

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 mattermost && \
    useradd -u 1000 -g mattermost -d /mattermost mattermost

WORKDIR /mattermost

# Copy binary from builder
COPY --from=builder /build/mattermost-server /mattermost/bin/mattermost

# Copy necessary files from builder
COPY --from=builder /build/i18n /mattermost/i18n
COPY --from=builder /build/templates /mattermost/templates
COPY --from=builder /build/config/config.json /mattermost/config/config.json

# Create data directories
RUN mkdir -p /mattermost/data /mattermost/logs /mattermost/plugins /mattermost/client/plugins && \
    chown -R mattermost:mattermost /mattermost

# Switch to non-root user
USER mattermost

# Expose ports
EXPOSE 8065
EXPOSE 8067

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8065/api/v4/system/ping || exit 1

# Set environment variables
ENV PATH="/mattermost/bin:${PATH}"
ENV DISABLE_LICENSE="1"

# Start mattermost
CMD ["mattermost"]
