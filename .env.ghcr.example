# Domain of service
DOMAIN=localhost

# Container settings
TZ=Europe/Moscow
RESTART_POLICY=unless-stopped

# Mattermost image from GHCR
# Replace 'yourusername' with your actual GitHub username/org
MATTERMOST_IMAGE=ghcr.io/yourusername/mattermost-server
MATTERMOST_IMAGE_TAG=latest

# Ports
APP_PORT=8065

# PostgreSQL settings
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mmuser-password
POSTGRES_DB=mattermost

# MinIO settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-password
MINIO_BUCKET=mattermost

# Mattermost environment variables
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable&connect_timeout=10

# File storage (MinIO S3)
MM_FILESETTINGS_DRIVERNAME=amazons3
MM_FILESETTINGS_AMAZONS3ENDPOINT=minio:9000
MM_FILESETTINGS_AMAZONS3ACCESSKEYID=${MINIO_ROOT_USER}
MM_FILESETTINGS_AMAZONS3SECRETACCESSKEY=${MINIO_ROOT_PASSWORD}
MM_FILESETTINGS_AMAZONS3BUCKET=${MINIO_BUCKET}
MM_FILESETTINGS_AMAZONS3REGION=us-east-1
MM_FILESETTINGS_AMAZONS3SSL=false

# Service settings
MM_SERVICESETTINGS_SITEURL=http://${DOMAIN}:${APP_PORT}
MM_SERVICESETTINGS_LISTENADDRESS=:8065
MM_SERVICESETTINGS_ENABLELOCALMODE=true

# License disabled
DISABLE_LICENSE=1

# Email settings
MM_EMAILSETTINGS_ENABLESIGNUPWITHEMAIL=true
MM_EMAILSETTINGS_ENABLESIGNINWITHEMAIL=true
MM_EMAILSETTINGS_ENABLESIGNINWITHUSERNAME=true
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=false
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION=false

# Team settings
MM_TEAMSETTINGS_ENABLETEAMCREATION=true
MM_TEAMSETTINGS_ENABLEOPENSERVER=true
